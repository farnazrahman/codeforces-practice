#include<stdio.h>
#include<string.h>
int main(){
    char str1[200005];
    char str2[200005];
    if (scanf("%s %s", str1, str2) != 2) return 0;
    
    int a= strlen(str1);
    int b=strlen(str2);
    int count=a+b;
    for(int i=a-1,j=b-1;i>=0 && j>=0;i--,j--){
        if(str1[i]==str2[j]){
            count=count-2;
        }else{
            break;
        }
    }
    printf("%d",count);
    
    return 0;
}