#include <stdio.h>
int main() 
{   
        int n;
        scanf("%d",&n);
        while(n--){
            int t;
            scanf("%d",&t);
            int mn=9;
            while(t != 0){
                int a = t%10;
                if(a<mn)mn=a;
                t = t/10;
            }printf("%d\n",mn);
        }
        

    return 0;
}