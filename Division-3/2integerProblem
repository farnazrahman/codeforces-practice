#include<stdio.h>

int main(){
    int t;
    scanf("%d",&t);
    while(t--){
        int a,b;
        scanf("%d %d",&a,&b);
        if(a==b){
            printf("0\n");
        }else if(a>b){
        int result = (a-b+9)/10;
        printf("%d\n",result);}
        else if(a<b){
        int result = (b-a+9)/10;
        printf("%d\n",result);}
    }
    return 0;
}