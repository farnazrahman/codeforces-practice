#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    while(n--){
        int x;
        scanf("%d",&x);        
        if(x%4==0){
            printf("%d\n",x/4);
        }else{
            int p=(x%4)/2;
            int q = x/4;
            printf("%d\n",p+q);
        }
}
    return 0;
}