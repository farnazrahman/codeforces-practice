#include<stdio.h>
int main(){
    int t;
    scanf("%d",&t);
    while(t--){
        int n,k;
        int count=0;
        int gold=0;
        
        scanf("%d %d",&n,&k);
        for(int i=0;i<n;i++){
            int x;
            scanf("%d",&x);
            
            
            
                if( x >= k){
                  gold = gold + x;
                }else if( x==0 && gold>0){
                    count++;
                    gold--;
                }
            
        }printf("%d\n",count);
    }
    return 0;
}