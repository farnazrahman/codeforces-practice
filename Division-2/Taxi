#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int count1=0,count2=0,count3=0,count4=0;
    for(int i=0;i<n;i++){
        if(arr[i]==1){count1++;}
        else if(arr[i]==2){count2++;}
       else if(arr[i]==3){count3++;}
       else if(arr[i]==4){count4++;}
    }
    if(count1<=count3){
        count1=0;
    }else if(count3<count1){
        count1=count1-count3;
    }
    int extra=0;

    int car_for_2_people=count2/2;
    
    if(count2%2){
        car_for_2_people++;
        if(count1){
        
            if(count1<=2){
                count1=0;
            }else{
            count1=count1-2;}
        }
    }
    if(count1){
        extra=count1/4;
        if(count1%4){
            extra++;
        }
    }
    int taxi = count4+count3+car_for_2_people+extra;
    printf("%d",taxi);
    
    return 0;
}