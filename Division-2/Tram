#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int max=0;
    int passenger=0;
    for(int i=0;i<n;i++){
         int a,b;
        scanf("%d %d",&a,&b);
        
            passenger=passenger+b-a;
            if(passenger>max){
                max=passenger;
            }
    }
    printf("%d",max);
return 0;
}