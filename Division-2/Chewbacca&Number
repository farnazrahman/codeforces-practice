#include<stdio.h>

int main(){
   char num[19];
   scanf("%s",num);
   for(int i=0;num[i] != '\0';i++){
        int digit = num[i]-'0';
        int new = 9 - digit;
        if(i==0 && new==0){
            continue;
        }
    if(new<digit){
        num[i] = new +'0';
    }
    }
   printf("%s\n",num);
    
    return 0;
}