#include<stdio.h>
int main(){
    int arr[100], n, temp;
    scanf("%d", &n);
    for(int i=0;i<n;i++) {
        scanf("%d",&arr[i]);
    }
    
    for(int i=0;i<n-1;i++) {
        for(int j=0;j<n-i-1;j++) {
            if(arr[j]<arr[j+1]) {   
                temp = arr[j];
                arr[j] = arr[j+1];
                arr[j+1] = temp;
            }
        }
    }
    int count=0;
    int sum=0;
    int sumcount=0;
    for(int i=0;i<n;i++){
        sum = sum+arr[i];
    }
    sum=sum/2;
    int i=0;
    do{
        sumcount=sumcount+arr[i];
        count++;
        i++;
    }while(sumcount<=sum);
    printf("%d",count);
return 0;
}