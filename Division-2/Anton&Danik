#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    char word[n+1];
    scanf("%s",word);
    int a=0;
    int d=0;
    for(int i=0;i<n;i++){
        if(word[i]=='A'){
            a++;
        }else if(word[i]=='D'){
            d++;}
        }if(a>d){
            printf("Anton");
        }else if(a<d){
            printf("Danik");
        }else{
            printf("Friendship");
        }
         return 0;
}