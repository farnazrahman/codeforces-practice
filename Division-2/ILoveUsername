#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }int count = 0;
    int min = arr[0];
    int max = arr[0];
   for(int i =1;i<n;i++){
   if (arr[i]>max){
    count++;
    max = arr[i];
   }else if(arr[i]<min){
    count++;
    min = arr[i];
   }
   }printf("%d",count);
    
    return 0;
}