#include<stdio.h>
int main(){
    int t;
    scanf("%d",&t);
    while(t--){
        int n;
        scanf("%d",&n);
        char s[n+1];
        scanf("%s",s);
        int count=1;
        for(int i=0;i<n;i++){
             if(s[i]=='R'){
                count++;
             }
             else{
                break;
             }
        }printf("%d\n",count);
    }
}