#include<stdio.h>

int main(){
   int t;
   scanf("%d",&t);
   while(t--){
      char str[100];
      scanf("%s",str);
      int len=0;
      for(int i=0;str[i]!='\0';i++){
           len++;
      }
    if(len<=10){
      printf("%s",str);
    }
    else{
      printf("%c%d%c",str[0],len-2,str[len-1]);
    }printf("\n");
   }
}