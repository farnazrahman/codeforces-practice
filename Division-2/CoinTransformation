#include<stdio.h>

int main(){
    
        int t;
        scanf("%d",&t);
        while(t--){
            long long n;
            scanf("%lld",&n);
            long long coin = 1;
            while(n>3){
                n /= 4;
                coin *= 2;
            }
        printf("%lld\n",coin);
        }
        
    return 0;
}