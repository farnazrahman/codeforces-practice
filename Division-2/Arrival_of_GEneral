#include<stdio.h>
int main(){
    int n;
    scanf("%d",&n);
    int arr[n];
    for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);
    }
    int max=arr[0];
    int min=arr[0];
    int max_index=0,min_index=0;
    for(int i=0;i<n;i++){
        if(arr[i]>max){
            max=arr[i];
            max_index=i;
        }else if(arr[i]<=min){
            min=arr[i];
            min_index=i;
        }
}if(max_index>min_index){
    printf("%d",max_index+n-2-min_index);
}else{
printf("%d",max_index+n-1-min_index);
}
return 0;
}