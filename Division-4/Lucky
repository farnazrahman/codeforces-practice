#include<stdio.h>

int main(){
    
        int t;
        scanf("%d",&t);
        while(t--){
           int a,b,c,d,e,f;
           scanf("%1d%1d%1d%1d%1d%1d",&a,&b,&c,&d,&e,&f);
           int sum1 = a+b+c;
           int sum2 = d+e+f;
           if(sum1 == sum2){
            printf("YES\n");
           }else{
            printf("NO\n");
           }
        }
    return 0;
}