#include<stdio.h>
int main(){
    int t;
    scanf("%d",&t);
    while(t--){
     char arr[6];
     scanf("%s",arr);
     int a=0;
    int b=0;
     for(int i=0;i<5;i++){
        if(arr[i]=='A'){
            a++;
        }else{b++;}
    }  
     if(a>b){
        printf("A\n");
     }else if(b>a){
        printf("B\n");
     }
    }
    return 0;
}