#include<stdio.h>
int main(){
    int t;
    scanf("%d",&t);
    while(t--){
        int n;
        scanf("%d",&n);
        char arr[101];
        scanf("%s",arr);
        int max = arr[0];
        for(int i=0;arr[i] != '\0';i++){
            if(arr[i]>max) {
            max = arr[i];
            }
        }printf("%d\n",max-'a'+1);
        
    }
    return 0;
}