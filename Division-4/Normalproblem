#include<stdio.h>
#include<string.h>

int main(){
    int t;
    scanf("%d",&t);
    while(t--){
        char word[100];
        scanf("%s",word);
        int len = strlen(word);
        for(int i=0;word[i]!='\0';i++){
            if(word[i] == 'p'){
                word[i]='q';
            }
            else if(word[i]=='q')
            {word[i]='p';}
        }for(int i=len-1;i>=0;i--){
            printf("%c",word[i]);
        }
        printf("\n");
    }
    return 0;
}