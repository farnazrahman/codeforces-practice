#include<stdio.h>
int main(){
    int t;
    scanf("%d",&t);
    while(t--){
     int n;
     scanf("%d",&n);
     int count=0;
     int arr[n];
     for(int i=0;i<n;i++)
     scanf("%d",&arr[i]);
      for(int i=0;i<n;i++){
        for(int j=0;j<i;j++)
        if(arr[i]==arr[j]){
            count=1;
        }
        
      }if(count==1){
        printf("NO\n");
      }else{
        printf("YES\n");
      }
        
    }
    return 0;
}