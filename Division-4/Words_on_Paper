#include <stdio.h>
int main() 
{   int t;
    scanf("%d",&t);
    while(t--){
        for(int r=0;r<8;r++){
            for(int c=0;c<8;c++){
                char ch;
                scanf(" %c",&ch);
                if(ch != '.'){
                    printf("%c",ch);
                }
            }
        }printf("\n");
    }
        

    return 0;
}