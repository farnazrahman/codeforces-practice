#include<stdio.h>
int main(){
    int x[4];
    for(int i=0;i<4;i++){
      scanf("%d",&x[i]);
    }for (int i=0;i<4;i++){
      for(int j=i+1;j<4;j++){
        if(x[j]<x[i]){
          int temp = x[i];
          x[i] = x[j];
          x[j] = temp;
        }
      }
    } int a = x[3]-x[2];
    int b = x[3]-x[1];
    int c = x[3]-x[0];
     printf("%d %d %d\n",a,b,c);
     return 0;
}