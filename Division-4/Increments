#include<stdio.h>
int main(){
     int t;
     scanf("%d",&t);
     while(t--){
        int n;
        scanf("%d",&n);
        int arr[n];
        for(int i=0;i<n;i++){
        scanf("%d",&arr[i]);}
        int count1=1;
        int count2 = 1;
        int evenParity = arr[0] % 2;
        int oddParity= arr[1] % 2;

for (int i = 0; i<n;i=i+2) {
    if (arr[i] % 2 != evenParity)
        count1 = 0;
}

for (int i=1;i<n;i=i+2) {
    if (arr[i] % 2 != oddParity)
        count2 = 0;
}
        if(count1 && count2)
    {
        printf("YES\n");
    }
    else{
        printf("NO\n");
    }
}
    return 0;
}