#include<stdio.h>
int main(){
 int t;
 scanf("%d",&t);
 while(t--){
  int n;
  scanf("%d",&n);
  int sum=0;
  int arr[n];
  for(int i=0;i<n;i++){
    scanf("%d",&arr[i]);
  }
  int smallest = arr[0];
  for(int i=0;i<n;i++){
  if(arr[i]<smallest)
  {smallest=arr[i];}
  }
  for(int i=0;i<n;i++){
    arr[i] = arr[i]-smallest;
    sum = sum + arr[i];
  }
  printf("%d\n",sum);
 
}
   return 0;
}