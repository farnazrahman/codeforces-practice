#include<stdio.h>
int main(){
   int t;
   scanf("%d",&t);
   while(t--){
    int n;
    scanf("%d",&n);
    char arr[n+1];
   scanf("%s",arr);
    int count=0;
    for(int i=0;i<n/2;i++){
    if((arr[i]=='1' && arr[n-i-1]=='0')||(arr[i]=='0' && arr[n-i-1]=='1') )
    {
        count++;
    }else {
        break;
    }
   
} printf("%d\n",n-2*count);
   }
    return 0;
}