#include<stdio.h>
int main(){
 int t;
 scanf("%d",&t);
 while(t--){
  int n;
  scanf("%d",&n);
  int arr[n];
  for(int i=0;i<n;i++){
    scanf("%d",&arr[i]);
  }
  int largest1 = arr[0];
  int largest2 = arr[1];
  if(arr[1]>arr[0])
  {largest1=arr[1];
  largest2=arr[0];}
  for(int i=2;i<n;i++){
    if(arr[i]>largest1){
    largest2 = largest1;
    largest1 = arr[i];
    } else if(arr[i]>largest2){
        largest2=arr[i];
    }
    }
  for(int i=0;i<n;i++){
    if(arr[i]==largest1){
     printf("%d ",arr[i]-largest2);
    }else{
      printf("%d ",arr[i]-largest1);
    }
  }
  printf("\n");
 }
   return 0;
}