#include <stdio.h>
#include<math.h>
int main() 
{   int t;
    scanf("%d",&t);
    while(t--){
        int n;
        scanf("%d",&n);
        int arr[n];
        long long total=0;
        int count=0;
        
        for(int i=0;i<n;i++){
            scanf("%d",&arr[i]);
        }
        for(int i=0;i<n;i++){
            total = total + arr[i];
        }
       long long r=sqrt((long double)total);

        if (r*r == total)
            printf("YES\n");
        else
            printf("NO\n");
    }

    return 0;
}