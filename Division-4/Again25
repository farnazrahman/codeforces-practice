#include<stdio.h>
#include<math.h>

int main(){
    int t;
    scanf("%d",&t);
     while(t--){
        char word[100];
        scanf("%s",word);
        int len = 0;
        while(word[len] != '\0'){
            len++;
        }

        int count = len / 2;

        if(len % 2 != 0){
            printf("NO\n");
        }else{
            for(int i = 0; i < len/2; i++){
                if(word[i] == word[i + (len/2)]){
                    count--;
                }else{
                    printf("NO\n");
                    break; }
            }
            if(count == 0){
                printf("YES\n");
            }
           } 
    }
    return 0;
}